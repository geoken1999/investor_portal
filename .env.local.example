# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only — never expose to the browser.
# Used only by src/lib/supabase/admin.ts for privileged operations
# (e.g. inviting an investor).
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute redirect URLs for email links (invite, password
# reset). Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
